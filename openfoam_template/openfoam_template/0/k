FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.0375;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.0375;
    }
    outlet
    {
        type            zeroGradient;
    }
    sides
    {
        type            zeroGradient;
    }
    symmetry
    {
        type            symmetryPlane;
    }
    tailfin
    {
        type            kLowReWallFunction;
        value           uniform 0.0375;
    }
}
