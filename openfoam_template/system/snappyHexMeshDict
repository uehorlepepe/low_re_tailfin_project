FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    tailfin.stl
    {
        type triSurfaceMesh;
        name tailfin;
    }
}

castellatedMeshControls
{
    maxLocalCells 1000000;
    maxGlobalCells 2000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 2;

    features
    (
        {
            file "tailfin.eMesh";
            level 3;
        }
    );

    refinementSurfaces
    {
        tailfin
        {
            level (2 3);
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
    }

    locationInMesh (-0.5 0.1 0.1);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 30;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes false;

    layers
    {
	tailfin
	{
	    nSurfaceLayers 15;
	}
    }
    expansionRatio 1.2;
    finalLayerThickness 0.000028;
    minThickness 0.0000028;
    nGrow 0;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minFlatness 0.5;
    minVol 1e-13;
    minTetQuality 1e-15;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.02;
    minVolRatio 0.01;
    minTriangleTwist -1;

    nSmoothScale 4;
    errorReduction 0.75;
}

mergeTolerance 1e-6;

addLayersControls
{
    relativeSizes false;
    expansionRatio 1.2;
    finalLayerThickness 0.0001;
    minimumThickness 0.00005;
    nSolveIter 30;
    nRelaxIter 5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    intermediateSmooth 0;
    nBufferLayers 0;
    maxThicknessToMedialRatio 0.3;
    minMedianAxisAngle 90;
    nGrow 0;
    featureAngle 60;
    slipFeatureAngle 30;
    relaxed
    {
        nMaximumCells 2000000;
        nRelaxIter 100;
    }
}
