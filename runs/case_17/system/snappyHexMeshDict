FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    tailfin.stl
    {
        type triSurfaceMesh;
        name tailfin;
    }
}

castellatedMeshControls
{
    maxLocalCells 1000000;
    maxGlobalCells 2000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 2;

    features
    (
        {
            file "tailfin.eMesh";
            level 3;
        }
    );

    refinementSurfaces
    {
        tailfin
        {
            level (6 7);
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
    }

    locationInMesh     (-0.2 0.1 0.1);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 30;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}



addLayersControls
{
    relativeSizes         false;
    nBufferCellsNoExtrude 3;
    featureAngle          60;
    nGrow                 0;

    layers
    {
        "tailfin"
        {
            nSurfaceLayers 12;
        }
    }

    expansionRatio        1.12;
    firstLayerThickness   0.000004;
    minThickness          1e-08;

    nSolveIter            100;
    nRelaxIter            8;
    nSmoothSurfaceNormals 2;
    nSmoothNormals        4;
    nSmoothThickness      20;
    maxFaceThicknessRatio 0.8;
    maxThicknessToMedialRatio 1.2;
    minMedialAxisAngle    30;
    nLayerIter            100;
    nRelaxedIter          40;
}

meshQualityControls
{
    maxNonOrtho 75;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minFlatness 0.5;
    minVol 1e-13;
    minTetQuality 1e-15;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.02;
    minVolRatio 0.01;
    minTriangleTwist -1;

    nSmoothScale 4;
    errorReduction 0.75;

    relaxed
    {
        maxNonOrtho 75;
        maxBoundarySkewness 30;
        maxInternalSkewness 8;
        maxConcavity 100;
        minVol 1e-15;
        minTetQuality -1e30;
        minDeterminant 0.0001;
    }
}

mergeTolerance 1e-6;


