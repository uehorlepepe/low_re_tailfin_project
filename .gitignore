# Ignore OpenFOAM mesh, generated files, and time directories
openfoam_template/processor*
openfoam_template/[1-9]*
openfoam_template/0.*/
openfoam_template/polyMesh/
openfoam_template/constant/polyMesh/
openfoam_template/constant/extendedFeatureEdgeMesh/
openfoam_template/constant/triSurface/*.stl
openfoam_template/constant/triSurface/*.eMesh

# Ignore Python cache & OS metadata
__pycache__/
*.pyc
.DS_Store
