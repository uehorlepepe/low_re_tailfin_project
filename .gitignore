# Ignore OpenFOAM mesh, generated files, and time directories
openfoam_template/processor*
openfoam_template/[1-9]*
openfoam_template/0.*/
openfoam_template/polyMesh/
openfoam_template/constant/polyMesh/
openfoam_template/constant/extendedFeatureEdgeMesh/
openfoam_template/constant/triSurface/*.stl
openfoam_template/constant/triSurface/*.eMesh

# Ignore Python cache & OS metadata
__pycache__/
*.pyc
.DS_Store

# Ignore bulky run artifacts (VTK exports, full session logs, IDE)
VTK/
runs*/*/VTK/
snappy_full.log
runs*/*/snappy_full.log
snappy_sc.log
runs*/*/snappy_sc.log
doe_*.log
beta_*.log
*_smoke.log
*_rerun.log
*_batch.log
lsb_full.log
lsb_smoke.log
terminal_all_bash.txt
zsh_history_raw.txt
.idea/

# Bulk CFD artifacts: time dirs + meshes stay local (per-case logs,
# postProcessing/*.dat and summary CSVs are the committed record)
runs*/*/[0-9]*/
runs*/*/constant/polyMesh/
runs*/*/processor*/
runs*/*/log.simpleFoam
runs*/*/constant/extendedFeatureEdgeMesh/
