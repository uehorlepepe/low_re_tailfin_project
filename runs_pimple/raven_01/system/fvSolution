FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}

solvers
{
    Phi
    {
        solver      PCG;
        preconditioner DIC;
        tolerance   1e-06;
        relTol      0.01;
    }

    phi
    {
        solver      PCG;
        preconditioner DIC;
        tolerance   1e-06;
        relTol      0.01;
    }

    p
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          0.01;
        smoother        GaussSeidel;
    }

    pFinal
    {
        solver          GAMG;
        tolerance       1e-07;
        relTol          0.001;
        smoother        GaussSeidel;
    }

    "(U|k|omega|gammaInt|ReThetat)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-06;
        relTol          0.1;
    }

    "(U|k|omega|gammaInt|ReThetat)Final"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-07;
        relTol          0.01;
    }
}

PIMPLE
{
    nOuterCorrectors  3;
    nCorrectors       2;
    nNonOrthogonalCorrectors 1;
    // fixed cost per step for the sanity run; add residualControl later
}
